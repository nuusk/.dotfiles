[global]
    monitor = 0
    follow = mouse
    width = 340
    height = 120
    origin = top-right
    offset = 40x40
    notification_limit = 4
    progress_bar = false
    indicate_hidden = yes
    transparency = 0
    separator_height = 0
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 1
    gap_size = 4
    separator_color = frame
    sort = yes
    font = BlexMono Nerd Font Mono 11
    line_height = 2
    markup = full
    alignment = left
    vertical_alignment = center
    show_age_threshold = 30
    ellipsize = end
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    corner_radius = 2
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

    format = "<span foreground='#795337'><b>%s</b></span>\n<span foreground='#3f3024'>%b</span>"

[urgency_low]
    background = "#f0e6d2"
    foreground = "#715b43"
    frame_color = "#baa17d"
    highlight = "#795337"
    timeout = 4

[urgency_normal]
    background = "#f7eedc"
    foreground = "#3f3024"
    frame_color = "#79533780"
    highlight = "#795337"
    timeout = 7

[urgency_critical]
    background = "#fff7f7"
    foreground = "#701f24"
    frame_color = "#a92d32b0"
    highlight = "#a92d32"
    timeout = 0
