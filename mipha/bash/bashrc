#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# alias ls='ls --color=auto'
alias ls=eza
alias bat=cat
alias grep='grep --color=auto'
alias k=kubectl
alias p=python3
complete -o default -F __start_kubectl k
PS1='[\u@\h \W]\$ '
eval "$(starship init bash)"

# Completion
[ -f /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion

# History
HISTSIZE=100000
HISTFILESIZE=200000
HISTCONTROL=ignoredups:erasedups
HISTTIMEFORMAT='%F %T '
shopt -s histappend
PROMPT_COMMAND="history -a; history -n; $PROMPT_COMMAND"

# fzf integration
[ -f /usr/share/fzf/key-bindings.bash ] && . /usr/share/fzf/key-bindings.bash
[ -f /usr/share/fzf/completion.bash ] && . /usr/share/fzf/completion.bash

# Git
export EDITOR=nvim

_wt_context() {
  local cmd=$1 main_worktree

  if ! WT_REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null); then
    echo "$cmd: not inside a git repository" >&2
    return 1
  fi

  if ! main_worktree=$(git -C "$WT_REPO_ROOT" worktree list --porcelain | sed -n '1s/^worktree //p'); then
    echo "$cmd: could not list git worktrees" >&2
    return 1
  fi
  if [[ -z $main_worktree ]]; then
    echo "$cmd: could not find the main git worktree" >&2
    return 1
  fi

  WT_REPO=$(basename "$main_worktree")
  WT_BASE="$HOME/worktrees/$WT_REPO"
}

wt() {
  local branch worktree_path

  if [[ $# -ne 1 ]]; then
    echo "usage: wt <new-branch>" >&2
    return 2
  fi

  branch=$1

  _wt_context wt || return
  worktree_path="$WT_BASE/$branch"

  if [[ -e "$worktree_path" ]]; then
    echo "wt: path already exists: $worktree_path" >&2
    return 1
  fi

  mkdir -p "$(dirname "$worktree_path")" &&
    git -C "$WT_REPO_ROOT" worktree add -b "$branch" "$worktree_path" &&
    {
      echo
      echo "Created worktree:"
      echo "  branch: $branch"
      echo "  path:   $worktree_path"
      echo

      if command -v figlet >/dev/null 2>&1; then
        figlet "$branch"
      else
        local border
        border=$(printf '%*s' "$((${#branch} + 4))" '' | tr ' ' '=')
        echo "$border"
        echo "= $branch ="
        echo "$border"
      fi

      cd "$worktree_path"
    }
}

wl() {
  local count=0

  _wt_context wl || return

  count=$(git -C "$WT_REPO_ROOT" worktree list --porcelain | sed -n 's/^worktree //p' | awk -v base="$WT_BASE/" 'index($0, base) == 1 { count++ } END { print count + 0 }')
  if [[ $count -eq 0 ]]; then
    echo "wl: no worktrees for $WT_REPO under $WT_BASE"
    return
  fi

  echo "Worktrees for $WT_REPO:"
  printf "%-32s %-32s %s\n" "name" "branch" "path"
  git -C "$WT_REPO_ROOT" worktree list --porcelain | awk -v base="$WT_BASE/" '
    /^worktree / {
      path = substr($0, 10)
      branch = "(detached)"
    }
    /^branch / {
      branch = substr($0, 8)
      sub(/^refs\/heads\//, "", branch)
    }
    /^$/ {
      print_entry()
      path = ""
      branch = "(detached)"
    }
    END {
      print_entry()
    }
    function print_entry() {
      if (path != "" && index(path, base) == 1) {
        name = substr(path, length(base) + 1)
        printf "%-32s %-32s %s\n", name, branch, path
        found = 1
      }
    }
  '
}

wr() {
  local name worktree_path current_worktree main_worktree

  if [[ $# -gt 1 ]]; then
    echo "usage: wr [worktree-name]" >&2
    return 2
  fi

  _wt_context wr || return

  if [[ $# -eq 0 ]]; then
    current_worktree=$WT_REPO_ROOT
    main_worktree=$(git -C "$current_worktree" worktree list --porcelain | sed -n '1s/^worktree //p')

    if [[ -z $main_worktree ]]; then
      echo "wr: could not find the main git worktree" >&2
      return 1
    fi
    if [[ $current_worktree -ef $main_worktree ]]; then
      echo "wr: cannot remove the main worktree" >&2
      return 1
    fi

    cd "$main_worktree" || return
    echo "Switched to main worktree: $PWD"
    git -C "$main_worktree" worktree remove --force "$current_worktree" &&
      echo "Removed worktree: $current_worktree"
    return
  fi

  name=$1
  worktree_path="$WT_BASE/$name"

  if [[ ! -d "$worktree_path" ]]; then
    echo "wr: no worktree at $worktree_path" >&2
    return 1
  fi

  git -C "$WT_REPO_ROOT" worktree remove --force "$worktree_path" &&
    echo "Removed worktree: $worktree_path"
}

wm() {
  _wt_context wm || return

  cd "$(git -C "$WT_REPO_ROOT" worktree list --porcelain | sed -n '1s/^worktree //p')" &&
    echo "Switched to main worktree: $PWD"
}

wra() {
  local worktree worktrees
  local removed=0

  _wt_context wra || return

  mapfile -t worktrees < <(git -C "$WT_REPO_ROOT" worktree list --porcelain | sed -n 's/^worktree //p' | awk -v base="$WT_BASE/" 'index($0, base) == 1')

  if [[ ${#worktrees[@]} -eq 0 ]]; then
    echo "wra: no worktrees to clean for $WT_REPO under $WT_BASE"
    return
  fi

  for worktree in "${worktrees[@]}"; do
    git -C "$WT_REPO_ROOT" worktree remove "$worktree" || return
    echo "Removed worktree: $worktree"
    ((removed++))
  done

  git -C "$WT_REPO_ROOT" worktree prune
  echo "Cleaned $removed worktree(s) for $WT_REPO."
}

ws() {
  local selected path
  local workspaces=()

  if [[ ! -d "$HOME/worktrees" ]]; then
    echo "ws: no workspace directory at $HOME/worktrees" >&2
    return 1
  fi

  mapfile -t workspaces < <(
    find "$HOME/worktrees" -name .git -print 2>/dev/null | while IFS= read -r git_meta; do
      path=${git_meta%/.git}
      git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>&1 || continue
      printf '%s\t%s\n' "${path#"$HOME/worktrees/"}" "$path"
    done | sort
  )

  if [[ ${#workspaces[@]} -eq 0 ]]; then
    echo "ws: no workspaces found under $HOME/worktrees" >&2
    return 1
  fi

  if [[ -t 0 && -t 1 ]] && command -v fzf >/dev/null 2>&1; then
    selected=$(printf '%s\n' "${workspaces[@]}" | fzf --prompt='workspace> ' --with-nth=1 --delimiter=$'\t') || return
  else
    select selected in "${workspaces[@]}"; do
      [[ -n $selected ]] && break
    done
  fi

  path=${selected#*$'\t'}
  if [[ ! -d "$path" ]]; then
    echo "ws: selected path does not exist: $path" >&2
    return 1
  fi

  cd "$path" && echo "Switched to workspace: ${path#"$HOME/worktrees/"}"
}

_wa_workspace_entries() {
  [[ -d "$HOME/worktrees" ]] || return

  find "$HOME/worktrees" -name .git -print 2>/dev/null | while IFS= read -r git_meta; do
    local path
    path=${git_meta%/.git}
    git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>&1 || continue
    printf '%s\t%s\n' "${path#"$HOME/worktrees/"}" "$path"
  done | sort
}

_wa_session_meta() {
  local file=$1 line payload root session_id

  IFS= read -r line <"$file" || return 1
  [[ $line == *'"type":"session_meta"'* && $line == *'"payload":{'* ]] || return 1

  payload=${line#*'"payload":{'}
  if [[ $payload == *'"session_id":"'* ]]; then
    session_id=${payload#*'"session_id":"'}
  elif [[ $payload == *'"id":"'* ]]; then
    session_id=${payload#*'"id":"'}
  else
    return 1
  fi
  session_id=${session_id%%\"*}

  [[ $payload == *'"cwd":"'* ]] || return 1
  root=${payload#*'"cwd":"'}
  root=${root%%\"*}

  [[ -n $root && -n $session_id ]] || return 1
  printf '%s\t%s\n' "$root" "$session_id"
}

_wa_session_entries() {
  [[ -d "$HOME/.codex/sessions" ]] || return

  find "$HOME/.codex/sessions" -type f -name 'rollout-*.jsonl' -printf '%T@\t%p\n' 2>/dev/null |
    sort -nr |
    while IFS=$'\t' read -r _ file; do
      local meta
      meta=$(_wa_session_meta "$file") || continue
      printf '%s\t%s\n' "$meta" "$file"
    done
}

_wa_latest_session_for_root() {
  local root=$1
  local file meta session_root session_id _

  [[ -d "$HOME/.codex/sessions" ]] || return 1

  while IFS=$'\t' read -r _ file; do
    meta=$(_wa_session_meta "$file") || continue
    IFS=$'\t' read -r session_root session_id <<<"$meta"
    if [[ $session_root == "$root" ]]; then
      printf '%s\n' "$session_id"
      return 0
    fi
  done < <(find "$HOME/.codex/sessions" -type f -name 'rollout-*.jsonl' -printf '%T@\t%p\n' 2>/dev/null | sort -nr)

  return 1
}

_wa_resolve_root() {
  local target=${1:-}
  local current_root main_worktree base root
  local matches=()

  if [[ -z $target || $target == "." ]]; then
    if ! git rev-parse --show-toplevel 2>/dev/null; then
      echo "wa: not inside a git repository; use wa --pick or wa <worktree-name>" >&2
      return 1
    fi
    return
  fi

  if [[ -d $target ]]; then
    git -C "$target" rev-parse --show-toplevel 2>/dev/null
    return
  fi

  if [[ -d "$HOME/worktrees/$target" ]]; then
    git -C "$HOME/worktrees/$target" rev-parse --show-toplevel 2>/dev/null
    return
  fi

  if current_root=$(git rev-parse --show-toplevel 2>/dev/null) &&
    main_worktree=$(git -C "$current_root" worktree list --porcelain | sed -n '1s/^worktree //p'); then
    base="$HOME/worktrees/$(basename "$main_worktree")"
    if [[ -d "$base/$target" ]]; then
      git -C "$base/$target" rev-parse --show-toplevel 2>/dev/null
      return
    fi
  fi

  while IFS=$'\t' read -r _ root; do
    [[ ${root##*/} == "$target" ]] && matches+=("$root")
  done < <(_wa_workspace_entries)

  case ${#matches[@]} in
  1)
    printf '%s\n' "${matches[0]}"
    ;;
  0)
    echo "wa: could not find worktree: $target" >&2
    return 1
    ;;
  *)
    echo "wa: ambiguous worktree name: $target" >&2
    printf '  %s\n' "${matches[@]}" >&2
    return 1
    ;;
  esac
}

_wa_select_root() {
  local selected
  local workspaces=()

  mapfile -t workspaces < <(_wa_workspace_entries)
  if [[ ${#workspaces[@]} -eq 0 ]]; then
    echo "wa: no workspaces found under $HOME/worktrees" >&2
    return 1
  fi

  if [[ -t 0 && -t 1 ]] && command -v fzf >/dev/null 2>&1; then
    selected=$(printf '%s\n' "${workspaces[@]}" | fzf --prompt='agent> ' --with-nth=1 --delimiter=$'\t') || return
  else
    select selected in "${workspaces[@]}"; do
      [[ -n $selected ]] && break
    done
  fi

  printf '%s\n' "${selected#*$'\t'}"
}

_wa_list() {
  local label root session_id
  declare -A latest_sessions=()

  while IFS=$'\t' read -r root session_id _; do
    [[ -n ${latest_sessions[$root]:-} ]] && continue
    latest_sessions[$root]=$session_id
  done < <(_wa_session_entries)

  printf "%-40s %-36s %s\n" "workspace" "latest session" "path"
  while IFS=$'\t' read -r label root; do
    session_id=${latest_sessions[$root]:-}
    [[ -n $session_id ]] || session_id="-"
    printf "%-40s %-36s %s\n" "$label" "$session_id" "$root"
  done < <(_wa_workspace_entries)
}

_wa_help() {
  cat <<'EOF'
usage:
  wa              resume latest Codex session for this worktree, or start one
  wa <name>       resume/start session for ~/worktrees/<repo>/<name>
  wa <repo/name>  resume/start session for ~/worktrees/<repo>/<name>
  wa --pick       choose a worktree, then resume/start its session
  wa --list       list worktrees and their latest Codex session
  wa --new        start a fresh Codex session for this worktree
EOF
}

wa() {
  local mode=resume target root session_id

  case ${1:-} in
  -h | --help)
    _wa_help
    return
    ;;
  --list)
    _wa_list
    return
    ;;
  --new)
    mode=new
    shift
    ;;
  --pick)
    root=$(_wa_select_root) || return
    shift
    ;;
  esac

  if [[ -z ${root:-} ]]; then
    if [[ ${1:-} == "--" ]]; then
      shift
    elif [[ -n ${1:-} && ${1:-} != -* ]]; then
      target=$1
      shift
    fi

    root=$(_wa_resolve_root "$target") || return
  fi

  if [[ ${1:-} == "--" ]]; then
    shift
  fi

  if [[ $mode != new ]] && session_id=$(_wa_latest_session_for_root "$root"); then
    echo "Resuming Codex agent for: $root"
    codex resume -C "$root" "$session_id" "$@"
    return
  fi

  echo "Starting new Codex agent for: $root"
  codex -C "$root" "$@"
}

h() {
  cat <<'EOF'
Custom shortcuts

Git worktrees
  wt <branch>   create branch and worktree at ~/worktrees/<repo>/<branch>, then cd there
  wl            list current repo worktrees under ~/worktrees/<repo>
  wr            remove the current worktree, then cd to the main worktree
  wr <name>     force remove ~/worktrees/<repo>/<name>
  wm            cd to the current repo main worktree
  wra           remove all current repo worktrees under ~/worktrees/<repo>
  ws            search all workspaces under ~/worktrees, then cd to the selected one
  wa            resume or start the Codex agent session for the current worktree
  wa --pick     choose a worktree, then resume/start its agent session
  wa --list     list worktrees and their latest Codex session

Aliases
  k             kubectl
  ls            eza
  bat           cat
  grep          grep --color=auto
  peon          peon-ping controls
EOF
}

# Secrets
[ -f "$HOME/.secrets/env" ] && source "$HOME/.secrets/env"

# peon-ping quick controls
alias peon="bash $HOME/.claude/hooks/peon-ping/peon.sh"
[ -f $HOME/.claude/hooks/peon-ping/completions.bash ] && source $HOME/.claude/hooks/peon-ping/completions.bash
